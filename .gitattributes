# Auto detect text files and perform LF normalization
* text=auto

# Explicitly keep source files as LF in the repository
*.html text eol=lf
*.js   text eol=lf
*.md   text eol=lf

# Images are binary — never apply line-ending conversion
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
